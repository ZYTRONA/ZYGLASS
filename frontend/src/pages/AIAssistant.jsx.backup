/**
 * AIAssistant — "Hey ZyGlass" dedicated page.
 *
 * Features:
 *  • Animated orb that reacts to voice state (idle / listening / wake / response)
 *  • Chat-like command/response history
 *  • Wake word visual indicator
 *  • Voice enable/disable
 *  • Command chips for quick reference
 */
import { useState, useRef, useEffect } from 'react'
import { motion, AnimatePresence } from 'framer-motion'
import {
  Mic, MicOff, Radio, Cpu, Zap, MessageSquare,
  CornerDownRight, Clock, VolumeX, Volume2,
  ChevronRight, Sparkles,
} from 'lucide-react'

const QUICK_CMDS = [
  'What mode am I in?',
  'Switch to object detection',
  'What did you see?',
  'Tell me about emotions',
  'How many faces do you know?',
  'Read the text',
  'Start lecture mode',
  'Stop lecture mode',
]

function OrbCore({ voiceState }) {
  const orbColor =
    voiceState.wake_detected ? 'var(--amber)'
    : voiceState.listening   ? 'var(--green)'
    : voiceState.enabled     ? 'var(--cyan)'
    : 'var(--text-3)'

  const pulseScale =
    voiceState.wake_detected ? [1, 1.25, 1]
    : voiceState.listening   ? [1, 1.12, 1]
    : [1, 1.03, 1]

  const pulseDur =
    voiceState.wake_detected ? 0.6
    : voiceState.listening   ? 1.2
    : 3.0

  return (
    <div style={{ position: 'relative', width: 180, height: 180, flexShrink: 0 }}>
      {/* Outer glow rings */}
      {[1.6, 1.3].map((scale, i) => (
        <motion.div
          key={i}
          animate={{ scale: [scale, scale * 1.08, scale], opacity: [0.18, 0.06, 0.18] }}
          transition={{ duration: pulseDur + i * 0.4, repeat: Infinity, ease: 'easeInOut' }}
          style={{
            position: 'absolute',
            inset: `${-(scale - 1) * 90}px`,
            borderRadius: '50%',
            background: `radial-gradient(circle, color-mix(in srgb, ${orbColor} 20%, transparent), transparent 70%)`,
          }}
        />
      ))}

      {/* Ring pulse on wake */}
      {(voiceState.wake_detected || voiceState.listening) && (
        <motion.div
          animate={{ scale: [1, 2], opacity: [0.5, 0] }}
          transition={{ duration: 1.2, repeat: Infinity, ease: 'easeOut' }}
          style={{
            position: 'absolute', inset: 20, borderRadius: '50%',
            border: `2px solid ${orbColor}`,
          }}
        />
      )}

      {/* Main orb */}
      <motion.div
        animate={{ scale: pulseScale }}
        transition={{ duration: pulseDur, repeat: Infinity, ease: 'easeInOut' }}
        style={{
          position: 'absolute', inset: 20,
          borderRadius: '50%',
          background: `radial-gradient(circle at 38% 38%,
            color-mix(in srgb, ${orbColor} 55%, white 20%),
            color-mix(in srgb, ${orbColor} 30%, transparent)
          )`,
          boxShadow: `0 0 40px color-mix(in srgb, ${orbColor} 50%, transparent),
                      0 0 80px color-mix(in srgb, ${orbColor} 20%, transparent),
                      inset 0 0 30px rgba(255,255,255,0.08)`,
          display: 'flex', alignItems: 'center', justifyContent: 'center',
          border: `1px solid color-mix(in srgb, ${orbColor} 60%, transparent)`,
        }}
      >
        {voiceState.wake_detected
          ? <Zap  size={32} color="#000" strokeWidth={2.5} />
          : voiceState.listening
            ? <Radio size={28} color="#000" strokeWidth={2} />
            : voiceState.enabled
              ? <Mic   size={28} color="#000" strokeWidth={2} />
              : <MicOff size={26} color="rgba(255,255,255,0.3)" strokeWidth={1.5} />
        }
      </motion.div>
    </div>
  )
}

function ChatBubble({ item, isNew }) {
  const isCmd = item.type === 'command'
  return (
    <motion.div
      initial={isNew ? { opacity: 0, y: 12, scale: 0.97 } : { opacity: 1 }}
      animate={{ opacity: 1, y: 0, scale: 1 }}
      transition={{ duration: 0.3, ease: [0.22, 1, 0.36, 1] }}
      style={{
        display: 'flex',
        flexDirection: isCmd ? 'row-reverse' : 'row',
        gap: 10, alignItems: 'flex-start',
      }}
    >
      {/* Avatar */}
      <div style={{
        width: 30, height: 30, borderRadius: '50%', flexShrink: 0,
        background: isCmd
          ? 'rgba(34,211,238,0.15)'
          : 'rgba(168,85,247,0.15)',
        border: isCmd
          ? '1px solid rgba(34,211,238,0.35)'
          : '1px solid rgba(168,85,247,0.35)',
        display: 'flex', alignItems: 'center', justifyContent: 'center',
      }}>
        {isCmd
          ? <Mic size={13} color="var(--cyan)" />
          : <Cpu size={13} color="var(--purple)" />
        }
      </div>

      {/* Bubble */}
      <div style={{
        maxWidth: '72%',
        padding: '9px 12px', borderRadius: isCmd ? '12px 4px 12px 12px' : '4px 12px 12px 12px',
        background: isCmd
          ? 'rgba(34,211,238,0.08)'
          : 'rgba(168,85,247,0.08)',
        border: isCmd
          ? '1px solid rgba(34,211,238,0.18)'
          : '1px solid rgba(168,85,247,0.18)',
      }}>
        <p style={{ fontSize: 12, color: 'var(--text-1)', lineHeight: 1.55 }}>{item.text}</p>
        {item.ts && (
          <p style={{ fontSize: 10, color: 'var(--text-3)', marginTop: 4 }}>{item.ts}</p>
        )}
      </div>
    </motion.div>
  )
}

export default function AIAssistant({ voiceState, onVoiceToggle }) {
  const [history, setHistory] = useState([])
  const chatRef = useRef(null)
  const prevLastCmd = useRef('')
  const prevLastResp = useRef('')

  // Update history when voiceState changes (all ref/impure logic inside effect)
  useEffect(() => {
    const cmd  = voiceState.last_command
    const resp = voiceState.last_response
    const ts   = voiceState.last_ts ?? new Date().toLocaleTimeString()

    const newEntries = []
    if (cmd && cmd !== prevLastCmd.current) {
      prevLastCmd.current = cmd
      newEntries.push({ type: 'command', text: cmd, ts, id: `${Date.now()}-cmd` })
    }
    if (resp && resp !== prevLastResp.current) {
      prevLastResp.current = resp
      newEntries.push({ type: 'response', text: resp, ts, id: `${Date.now()}-resp` })
    }

    // Use queueMicrotask to defer setState and avoid cascading renders warning
    if (newEntries.length > 0) {
      queueMicrotask(() => {
        setHistory(h => [...h, ...newEntries])
      })
    }
  }, [voiceState.last_command, voiceState.last_response, voiceState.last_ts])

  // Auto-scroll chat
  useEffect(() => {
    if (chatRef.current) chatRef.current.scrollTop = chatRef.current.scrollHeight
  }, [history])

  const stateLabel =
    voiceState.wake_detected ? '⚡ Wake word detected!'
    : voiceState.listening   ? 'Listening for command…'
    : voiceState.enabled     ? 'Say "Hey ZyGlass" to activate'
    : 'Voice assistant is off'

  const stateColor =
    voiceState.wake_detected ? 'var(--amber)'
    : voiceState.listening   ? 'var(--green)'
    : voiceState.enabled     ? 'var(--cyan)'
    : 'var(--text-3)'

  return (
    <div style={{ height: '100%', display: 'flex', flexDirection: 'column', background: 'var(--bg-0)', overflow: 'hidden' }}>

      {/* Top bar */}
      <div style={{
        padding: '14px 24px', borderBottom: '1px solid var(--cyan-border)',
        background: 'var(--bg-1)', flexShrink: 0,
        display: 'flex', alignItems: 'center', gap: 10,
      }}>
        <Sparkles size={14} color="var(--purple)" />
        <p style={{ fontSize: 11, fontWeight: 700, letterSpacing: '0.14em', color: 'var(--text-2)', textTransform: 'uppercase' }}>
          ZyGlass AI
        </p>
        <div style={{
          marginLeft: 'auto', display: 'flex', alignItems: 'center', gap: 6,
          padding: '4px 10px', borderRadius: 20,
          background: `color-mix(in srgb, ${stateColor} 10%, transparent)`,
          border: `1px solid color-mix(in srgb, ${stateColor} 30%, transparent)`,
        }}>
          <div style={{
            width: 6, height: 6, borderRadius: '50%', background: stateColor,
            boxShadow: voiceState.listening ? `0 0 6px ${stateColor}` : 'none',
            animation: voiceState.listening ? 'glow-breathe 1.5s ease-in-out infinite' : 'none',
          }} />
          <span style={{ fontSize: 10, color: stateColor, fontWeight: 600, letterSpacing: '0.06em' }}>
            {stateLabel}
          </span>
        </div>
      </div>

      {/* Body: orb (left) + chat (right) */}
      <div style={{ flex: 1, display: 'flex', overflow: 'hidden' }}>

        {/* Left: orb + controls */}
        <div style={{
          width: 280, flexShrink: 0, borderRight: '1px solid var(--cyan-border)',
          display: 'flex', flexDirection: 'column', alignItems: 'center',
          padding: '28px 20px 20px', gap: 20, background: 'var(--bg-1)',
        }}>
          {/* Orb */}
          <OrbCore voiceState={voiceState} />

          {/* Brand text */}
          <div style={{ textAlign: 'center' }}>
            <p style={{
              fontSize: 22, fontWeight: 800, letterSpacing: '-0.01em',
              background: 'linear-gradient(135deg, var(--cyan) 30%, var(--purple))',
              WebkitBackgroundClip: 'text', WebkitTextFillColor: 'transparent', backgroundClip: 'text',
            }}>
              ZyGlass AI
            </p>
            <p style={{ fontSize: 11, color: 'var(--text-3)', marginTop: 2 }}>
              Offline · Whisper STT · LLM powered
            </p>
          </div>

          {/* Voice toggle */}
          <motion.button
            onClick={onVoiceToggle}
            whileHover={{ scale: 1.03 }}
            whileTap={{ scale: 0.96 }}
            style={{
              display: 'flex', alignItems: 'center', gap: 8, padding: '10px 20px',
              borderRadius: 10, border: `1px solid ${voiceState.enabled ? 'rgba(74,222,128,0.4)' : 'rgba(255,255,255,0.12)'}`,
              background: voiceState.enabled ? 'rgba(74,222,128,0.10)' : 'rgba(255,255,255,0.05)',
              color: voiceState.enabled ? 'var(--green)' : 'var(--text-2)',
              cursor: 'pointer', fontSize: 13, fontWeight: 600, width: '100%', justifyContent: 'center',
              transition: 'all 0.25s',
            }}
          >
            {voiceState.enabled
              ? <><Volume2 size={15} /> Disable Voice</>
              : <><VolumeX size={15} /> Enable Voice</>
            }
          </motion.button>

          {/* Wake word hint */}
          <div style={{
            padding: '12px', borderRadius: 10, width: '100%',
            background: 'rgba(34,211,238,0.04)', border: '1px solid rgba(34,211,238,0.12)',
          }}>
            <div style={{ display: 'flex', gap: 6, marginBottom: 8 }}>
              <Radio size={13} color="var(--cyan)" />
              <p style={{ fontSize: 10, fontWeight: 700, letterSpacing: '0.1em', color: 'var(--cyan)' }}>
                WAKE WORD
              </p>
            </div>
            <p style={{
              fontSize: 15, fontWeight: 700, color: 'var(--text-1)', letterSpacing: '0.01em',
              fontStyle: 'italic', borderBottom: '1px solid rgba(34,211,238,0.1)', paddingBottom: 8, marginBottom: 8,
            }}>
              "Hey ZyGlass"
            </p>
            <p style={{ fontSize: 10, color: 'var(--text-3)', lineHeight: 1.6 }}>
              Uses faster-whisper offline STT + Ollama LLM.
              Works without internet connection.
            </p>
          </div>

          {/* Stats */}
          <div style={{ width: '100%', display: 'flex', flexDirection: 'column', gap: 6, marginTop: 'auto' }}>
            {[
              { label: 'Whisper STT', value: 'Offline' },
              { label: 'LLM',         value: 'llama3.2'  },
              { label: 'TTS',         value: 'pyttsx3'   },
            ].map(({ label, value }) => (
              <div key={label} style={{ display: 'flex', justifyContent: 'space-between', fontSize: 10, color: 'var(--text-3)' }}>
                <span>{label}</span>
                <span style={{ color: 'var(--text-2)', fontWeight: 600 }}>{value}</span>
              </div>
            ))}
          </div>
        </div>

        {/* Right: chat */}
        <div style={{ flex: 1, display: 'flex', flexDirection: 'column', overflow: 'hidden' }}>

          {/* Chat area */}
          <div
            ref={chatRef}
            style={{
              flex: 1, overflowY: 'auto', padding: '20px 24px',
              display: 'flex', flexDirection: 'column', gap: 14,
            }}
          >
            {history.length === 0 && (
              <motion.div
                initial={{ opacity: 0 }}
                animate={{ opacity: 1 }}
                style={{ textAlign: 'center', padding: '40px 20px', color: 'var(--text-3)' }}
              >
                <MessageSquare size={36} strokeWidth={1} style={{ margin: '0 auto 12px', opacity: 0.4 }} />
                <p style={{ fontSize: 14, marginBottom: 6 }}>No commands yet</p>
                <p style={{ fontSize: 12 }}>Enable voice and say "Hey ZyGlass" to begin</p>
              </motion.div>
            )}

            <AnimatePresence>
              {history.map((item, i) => (
                <ChatBubble
                  key={item.id}
                  item={item}
                  isNew={i === history.length - 1}
                />
              ))}
            </AnimatePresence>

            {/* Live "listening" indicator */}
            {voiceState.listening && (
              <motion.div
                initial={{ opacity: 0 }}
                animate={{ opacity: 1 }}
                exit={{ opacity: 0 }}
                style={{
                  display: 'flex', alignItems: 'center', gap: 8,
                  padding: '8px 12px', borderRadius: 10,
                  background: 'rgba(74,222,128,0.06)', border: '1px solid rgba(74,222,128,0.2)',
                  color: 'var(--green)', fontSize: 12, width: 'fit-content',
                }}
              >
                <motion.div
                  animate={{ scaleY: [1, 1.8, 1, 1.4, 1] }}
                  transition={{ duration: 0.8, repeat: Infinity }}
                  style={{ display: 'flex', gap: 3, alignItems: 'center' }}
                >
                  {[0, 1, 2].map(i => (
                    <motion.div
                      key={i}
                      animate={{ scaleY: [0.5, 1.5, 0.5] }}
                      transition={{ duration: 0.6, repeat: Infinity, delay: i * 0.15 }}
                      style={{ width: 3, height: 14, background: 'var(--green)', borderRadius: 2 }}
                    />
                  ))}
                </motion.div>
                <span>Listening…</span>
              </motion.div>
            )}
          </div>

          {/* Quick commands */}
          <div style={{
            padding: '14px 24px',
            borderTop: '1px solid var(--cyan-border)',
            background: 'var(--bg-1)',
          }}>
            <p style={{ fontSize: 10, fontWeight: 700, letterSpacing: '0.1em', color: 'var(--text-3)', marginBottom: 8, textTransform: 'uppercase' }}>
              Example commands
            </p>
            <div style={{ display: 'flex', flexWrap: 'wrap', gap: 6 }}>
              {QUICK_CMDS.map(cmd => (
                <div
                  key={cmd}
                  style={{
                    padding: '4px 10px', borderRadius: 20,
                    background: 'rgba(34,211,238,0.05)', border: '1px solid rgba(34,211,238,0.15)',
                    fontSize: 11, color: 'var(--text-2)', fontStyle: 'italic',
                    whiteSpace: 'nowrap',
                  }}
                >
                  "{cmd}"
                </div>
              ))}
            </div>
          </div>
        </div>

      </div>
    </div>
  )
}
